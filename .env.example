# Optional overrides. The app runs without a .env file.
API_BASE_URL=http://127.0.0.1:8000

# Local MongoDB from docker compose; MongoDB Atlas also works.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=interview_coach

# Generate a unique value, for example with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=60

# Local Ollama is the zero API-cost option. Install Ollama and download the models
# to get AI features; without it, the app uses built-in demo questions/placeholder feedback.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Optional remote providers. These require API keys and may have usage limits/costs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional OpenAI provider: set AI_PROVIDER=openai and add its key instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional local Whisper model: tiny, base, small, medium, or large.
WHISPER_MODEL=base

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
