# Optional overrides. The launcher loads the private project .env file.
API_BASE_URL=http://127.0.0.1:8000

# Local MongoDB Community Server (no Docker required).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=interview_coach
MONGODB_REQUIRED=true

# Generate a unique value, for example with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=60

# Local-only AI via Ollama. No remote API keys are used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT_SECONDS=300

# Optional local Whisper model: tiny, base, small, medium, or large.
WHISPER_MODEL=base

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
